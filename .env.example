# ── Relais SMTP des formulaires (contact, leads, pop-up de sortie) ──
# Renseignez un serveur SMTP : les messages sont relayés vers CONTACT_TO.
# Sans config, les formulaires restent fonctionnels (log serveur, pas d'envoi).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false            # true pour le port 465 (SSL), false pour 587 (STARTTLS)
SMTP_USER=votre-compte@gmail.com
SMTP_PASSWORD=mot-de-passe-application   # Gmail : "mot de passe d'application"
MAIL_FROM="Formulaires <votre-compte@gmail.com>"

# Destinataires (séparés par des virgules)
CONTACT_TO=albert.lanne@gmail.com,ekomedia.fr@gmail.com,mouhsine.rasfa@gmail.com
